load("@rules_python//python:defs.bzl", "py_library")

# enodebd's entry point onto the shared //lte/gateway/python/magma/tr069 stack.
py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//lte/gateway/python/magma/enodebd:logger",
        "//lte/gateway/python/magma/enodebd/state_machines:enb_acs_manager",
        "//lte/gateway/python/magma/tr069:logger",
        "//lte/gateway/python/magma/tr069:server",
    ],
)

# Deprecated aliases: the TR-069 codec moved to //lte/gateway/python/magma/tr069.
py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//visibility:public"],
    deps = ["//lte/gateway/python/magma/tr069:models"],
)

py_library(
    name = "rpc_methods",
    srcs = ["rpc_methods.py"],
    visibility = ["//visibility:public"],
    deps = ["//lte/gateway/python/magma/tr069:rpc_methods"],
)

py_library(
    name = "spyne_mods",
    srcs = ["spyne_mods.py"],
    visibility = ["//visibility:public"],
    deps = ["//lte/gateway/python/magma/tr069:spyne_mods"],
)
