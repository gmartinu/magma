load("@python_deps//:requirements.bzl", "requirement")
load("//bazel:python_test.bzl", "pytest_test")

MAGMA_ROOT = "../../../../../../"

ORC8R_ROOT = "{}orc8r/gateway/python".format(MAGMA_ROOT)

LTE_ROOT = "{}lte/gateway/python".format(MAGMA_ROOT)

pytest_test(
    name = "logger_tests",
    size = "small",
    srcs = ["logger_tests.py"],
    imports = [
        LTE_ROOT,
        ORC8R_ROOT,
    ],
    deps = [
        "//lte/gateway/python/magma/tr069:logger",
        "//lte/gateway/python/magma/tr069:server",
    ],
)

pytest_test(
    name = "models_tests",
    size = "small",
    srcs = ["models_tests.py"],
    imports = [LTE_ROOT],
    deps = ["//lte/gateway/python/magma/tr069:models"],
)

pytest_test(
    name = "server_tests",
    size = "small",
    srcs = ["server_tests.py"],
    imports = [
        LTE_ROOT,
        ORC8R_ROOT,
    ],
    deps = [
        "//lte/gateway/python/magma/tr069:logger",
        "//lte/gateway/python/magma/tr069:server",
    ],
)

pytest_test(
    name = "spyne_mods_tests",
    size = "small",
    srcs = ["spyne_mods_tests.py"],
    imports = [LTE_ROOT],
    deps = [
        "//lte/gateway/python/magma/tr069:models",
        "//lte/gateway/python/magma/tr069:spyne_mods",
    ],
)

pytest_test(
    name = "rpc_methods_tests",
    size = "small",
    srcs = ["rpc_methods_tests.py"],
    imports = [LTE_ROOT],
    deps = [
        "//lte/gateway/python/magma/tr069:models",
        "//lte/gateway/python/magma/tr069:rpc_methods",
        "//lte/gateway/python/magma/tr069:spyne_mods",
        requirement("spyne"),
    ],
)
