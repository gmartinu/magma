{
  "configs_by_key": {
    "acsd": {
      "@type": "type.googleapis.com/magma.mconfig.AcsD",
      "logLevel": "INFO",
      "mode": "ACTIVE",
      "port": 48081,
      "periodicInformInterval": 0
    },
    "mobilityd": {
      "@type": "type.googleapis.com/magma.mconfig.MobilityD",
      "ipBlock": "192.168.128.0/24",
